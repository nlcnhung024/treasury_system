# =============================================================================
# BIẾN MÔI TRƯỜNG PHÁT TRIỂN DỰ ÁN (LOCAL & DEV ENVIRONMENT CONFIGURATION)
# Dự án: Hệ thống Xử lý & Báo cáo Sao kê Ngân hàng Tự động (BSP-2026)
# =============================================================================

# 1. Ứng dụng Backend & Môi trường
ENVIRONMENT=development
DEBUG=True
APP_NAME="Bank Statement Processing & Reporting System"
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# 2. Cơ sở dữ liệu (PostgreSQL 15+)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bank_statement_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_2026
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SYNC_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# 3. Message Broker & Cụm Cache (Redis 7.0+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password_2026
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2

# 4. Kho Lưu trữ Nhị phân (MinIO On-Premise Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_2026
MINIO_BUCKET_NAME=statements
MINIO_USE_SSL=False

# 5. Xác thực & Bảo mật (JWT Authentication & Security)
JWT_SECRET_KEY=bsp_super_secret_jwt_key_development_must_be_changed_in_prod_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_INTERNAL=bsp_worker_internal_secret_api_key_2026

# 6. Cấu hình Giới hạn Tải file & Xử lý (File Upload Constraints)
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=[".xlsx",".xls",".csv"]
STREAM_CHUNK_SIZE=500
MAX_UNCOMPRESSED_RATIO=50
MAX_ROWS_PER_SHEET=100000

# 7. Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="BSP - Hệ thống Xử lý & Báo cáo Sao kê Ngân hàng"

